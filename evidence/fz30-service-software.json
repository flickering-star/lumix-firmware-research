    {
      "subject": "Read EEPROM wrapper",
      "source": "fz30.exe PE virtual addresses 0x40d110 through 0x40d1e5",
      "observations": [
        "Busy! Read EEPROM branch identifies the wrapper.",
        "Copies low/high address bytes from ECX and one selector byte from DL into a three-byte payload.",
        "Passes type 0x08 and operation 0x38 into a shared request routine."
      ],
      "limits": "16-bit address plus selector does not establish a CPU-address memory reader or access to program regions."
    },
    {
      "subject": "Request construction",
      "source": "fz30.exe PE virtual addresses 0x40c6e4, 0x40cdbc and 0x40c850",
      "observations": [
        "For this read path, constructs a 16-byte buffer.",
        "Prefix is 08 00 ff 38 followed by address-low, address-high and selector.",
        "Unused payload bytes are zero filled; byte 14 holds the modulo-256 sum of bytes 1..13 and byte 15 is zero."
      ],
      "limits": "Static host-side reconstruction only; no captured USB transaction or camera test."
    },
    {
      "subject": "Backup scope",
      "source": "howto.pdf pages 3-4 and submenu.txt",
      "observations": [
        "Labels the saved file as EEPROM data.",
        "Describes an EEPRAM/EEPROM editor and calibration backup, not a full executable firmware image."
      ],
      "limits": "Does not settle the scope of a later GM5 adjustment package."
    }
